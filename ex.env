# Covered — environment template (committed)
#
# Copy to local.env for local development:
#   cp ex.env local.env
#
# Put real secrets only in local.env (gitignored).
# When adding a new variable, add it here first, then set the value in local.env.

# App
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# Database — prototype: SQLite file (swap driver later, e.g. mysql)
DATABASE_DRIVER=sqlite
DATABASE_DSN=file:./data/covered.db?cache=shared&mode=rwc

# Cache — prototype: in-process memory (swap to redis later)
CACHE_BACKEND=memory
# CACHE_REDIS_URL=redis://localhost:6379/0

# Blob storage for uploads — prototype: local disk (swap to s3 later)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads

# LLM / embeddings (when added)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=

# OCR / document parsing (when added)
OCR_PROVIDER=
OCR_API_KEY=

# Auth / sessions — prototype uses anonymous sessions (no accounts)
SESSION_SECRET=change-me-in-local-env

# Logging
LOG_LEVEL=debug
