# Covered — environment template (committed)
#
# Copy to local.env for local development:
#   cp ex.env local.env
#
# Put real secrets only in local.env (gitignored).
# When adding a new variable, add it here first, then set the value in local.env.

# App
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# Database (when added)
DATABASE_URL=postgres://covered:covered@localhost:5432/covered?sslmode=disable

# Object storage for uploaded insurance documents (when added)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads

# LLM / embeddings (when added)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=

# OCR / document parsing (when added)
OCR_PROVIDER=
OCR_API_KEY=

# Auth / sessions (when added)
SESSION_SECRET=change-me-in-local-env

# Logging
LOG_LEVEL=debug
